<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Lotus palette (taken from the browser's own theme) -->
    <SolidColorBrush x:Key="BlushBrush" Color="#FDECEF"/>
    <SolidColorBrush x:Key="PetalBrush" Color="#F0BFC9"/>
    <SolidColorBrush x:Key="PetalSoftBrush" Color="#F6D9DF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFF6F8"/>
    <SolidColorBrush x:Key="RoseBrush" Color="#8C3A4D"/>
    <SolidColorBrush x:Key="RoseHoverBrush" Color="#732F40"/>
    <SolidColorBrush x:Key="PlumBrush" Color="#3A1F27"/>
    <SolidColorBrush x:Key="BodyBrush" Color="#5C3944"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7A5460"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

