<Window x:Class="Lotus.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lotus Setup" Width="860" Height="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="Window_KeyDown" Closing="Window_Closing">

    <Grid Margin="24" MouseLeftButtonDown="Root_MouseDown">

        <!-- Card with soft shadow (kept child-free so only the card casts it) -->
        <Border CornerRadius="22" Background="{StaticResource BlushBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.30" Color="#3A1F27"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Brand panel ============ -->
            <Border Grid.Column="0" CornerRadius="22,0,0,22" Background="{StaticResource RoseBrush}">
                <Grid>
                    <!-- ripples on the pond surface -->
                    <Ellipse Width="150" Height="30" Stroke="#40FDECEF" StrokeThickness="1.5"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,247,0,0"/>
                    <Ellipse Width="212" Height="44" Stroke="#28FDECEF" StrokeThickness="1.5"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,240,0,0"/>
                    <Ellipse Width="274" Height="60" Stroke="#16FDECEF" StrokeThickness="1.5"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,232,0,0"/>

                    <!-- the lotus: blooms as the install progresses -->
                    <Viewbox Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,86,0,0">
                        <Canvas Width="512" Height="512">
                            <Path x:Name="Petal0" Data="{StaticResource LotusPetalBottom}" Fill="#FF828C">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal1" Data="{StaticResource LotusPetalWide}" Fill="#FF96A0">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal2" Data="{StaticResource LotusPetalCenter}" Fill="#FF828C">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal3" Data="{StaticResource LotusPetalLeftInner}" Fill="#FF96A0">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal4" Data="{StaticResource LotusPetalRightInner}" Fill="#FF96A0">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal5" Data="{StaticResource LotusPetalLeft}" Fill="#FFA6B1">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal6" Data="{StaticResource LotusPetalRight}" Fill="#FFA6B1">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                            <Path x:Name="Petal7" Data="{StaticResource LotusPetalTop}" Fill="#FFA6B1">
                                <Path.RenderTransform><ScaleTransform CenterX="256" CenterY="400"/></Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,38">
                        <TextBlock Text="Lotus" FontFamily="{StaticResource DisplayFont}" FontSize="40"
                                   FontWeight="SemiBold" Foreground="#FDECEF"/>
                        <TextBlock x:Name="VersionText" FontSize="13" Foreground="#F0BFC9" Margin="2,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Grid.Column="1">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,16,0" Panel.ZIndex="5">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="Min_Click"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <Path Data="M0,0 L10,0" Stroke="{StaticResource BodyBrush}" StrokeThickness="1.6" Width="10" Height="2"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource BodyBrush}" StrokeThickness="1.6" Width="10" Height="10"/>
                    </Button>
                </StackPanel>

                <Grid x:Name="PageHost" Margin="48,56,48,36">

                    <!-- Welcome / options -->
                    <Grid x:Name="PageWelcome" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Heading}" Text="Welcome to Lotus"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Body}" Margin="0,8,0,0"
                                   Text="Installs for your account only, so no admin rights are needed."/>
                        <ScrollViewer Grid.Row="2" Margin="0,24,0,12" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Install location"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" TextChanged="PathBox_TextChanged"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="Browse_Click"/>
                                </Grid>
                                <TextBlock x:Name="PathError" Style="{StaticResource ErrorText}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="SpaceText" Style="{StaticResource Caption}" Margin="0,6,0,0"/>

                                <StackPanel Margin="0,22,0,0">
                                    <CheckBox x:Name="DesktopSwitch" Style="{StaticResource SwitchStyle}" IsChecked="True" Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource PlumBrush}" Text="Add a desktop shortcut"/>
                                    </CheckBox>
                                    <CheckBox x:Name="DefaultSwitch" Style="{StaticResource SwitchStyle}" IsChecked="True" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource PlumBrush}" Text="Make Lotus my default browser"/>
                                            <TextBlock Style="{StaticResource Caption}" Text="Windows Settings opens when setup finishes so you can confirm the change."/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="LaunchSwitch" Style="{StaticResource SwitchStyle}" IsChecked="True">
                                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource PlumBrush}" Text="Open Lotus when setup finishes"/>
                                    </CheckBox>
                                </StackPanel>

                                <Border x:Name="WebViewNotice" Visibility="Collapsed" Margin="0,20,0,0" Padding="14,10"
                                        CornerRadius="10" Background="{StaticResource PetalSoftBrush}">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource BodyBrush}"
                                               Text="Lotus needs Microsoft's WebView2 Runtime. It isn't on this PC yet, so setup will download and install it for you."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Close_Click"/>
                            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress -->
                    <Grid x:Name="PageProgress" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}" Text="Installing Lotus"/>
                        <TextBlock x:Name="ProgressStatus" Grid.Row="1" Style="{StaticResource Body}" Margin="0,8,0,0" Text="Preparing"/>
                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <Grid x:Name="BarTrack" Height="10">
                                <Border CornerRadius="5" Background="{StaticResource PetalBrush}" Opacity="0.6"/>
                                <Border x:Name="BarFill" CornerRadius="5" Background="{StaticResource RoseBrush}"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" Margin="0,0,56,0"/>
                                <TextBlock x:Name="ProgressPercent" Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="0%"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Lotus is running -->
                    <Grid x:Name="PageClose" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Lotus is still open"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                       Text="Setup has to close it before it can continue. Any tabs you have open will be closed."/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Go back" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CloseCancel_Click"/>
                            <Button x:Name="CloseContinueButton" Content="Close Lotus and continue" Style="{StaticResource PrimaryButton}" Click="CloseContinue_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Uninstall confirm -->
                    <Grid x:Name="PageUninstall" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Uninstall Lotus?"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                       Text="Lotus will be removed from this PC. Your bookmarks and history are kept unless you choose otherwise below."/>
                            <CheckBox x:Name="DeleteDataSwitch" Style="{StaticResource SwitchStyle}" Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource PlumBrush}"
                                               Text="Also delete my bookmarks, history and browsing data"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Stored in AppData\Local\LotusBrowser. This can't be undone."/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Close_Click"/>
                            <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Done / error -->
                    <Grid x:Name="PageDone" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DoneNote" Style="{StaticResource Caption}" Margin="0,14,0,0" Visibility="Collapsed"/>
                            <Button x:Name="WebViewLinkButton" Content="Get the WebView2 Runtime" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="WebViewLink_Click"/>
                            <TextBox x:Name="ErrorBox" Style="{StaticResource FieldBox}" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource PrimaryButton}" Click="Finish_Click"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
